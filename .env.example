# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-dev-tunnel.example
SCOPES=read_orders,read_customers,read_products,read_store_credit_accounts,read_store_credit_account_transactions,write_store_credit_account_transactions

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/creditflow_dev?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/creditflow_shadow?schema=public

# Generate a unique random value with at least 32 characters.
CREDITFLOW_WORKER_SECRET=

# Transactional email delivery (Resend). Use a sender address on a verified domain.
RESEND_API_KEY=
CREDITFLOW_EMAIL_FROM=CreditFlow <rewards@your-verified-domain.example>

# Optional managed scheduler configuration.
WORKER_APP_URL=
WORKER_BATCH_LIMIT=5
